# Copy to .dev.vars for local Worker development.
# Never commit .dev.vars.

# Firebase project ID used to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id

# RS256 PKCS#8 private key for entitlement signing.
# Generate a key pair locally; keep the private key only in .dev.vars / Cloudflare secret.
ENTITLEMENT_SIGNING_KEY_ID=mygate-entitlement-v1
ENTITLEMENT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
