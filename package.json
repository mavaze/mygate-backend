{
  "name": "mygate-backend",
  "version": "0.2.0",
  "private": true,
  "description": "My Gate control-plane API - Cloudflare Worker + D1 + Firebase Auth",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply mygate-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply mygate-control --remote",
    "db:console:local": "wrangler d1 execute mygate-control --local --command",
    "typecheck": "npm run generate-types && tsc --noEmit",
    "generate-types": "wrangler types --include-env=false"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.137.0"
  }
}
