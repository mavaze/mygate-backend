{
  "name": "mygate-backend",
  "version": "0.1.0",
  "private": true,
  "description": "My Gate control-plane API - Cloudflare Worker + D1 + Firebase Auth",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply mygate-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply mygate-control --remote",
    "db:console:local": "wrangler d1 execute mygate-control --local --command",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.137.0"
  }
}
